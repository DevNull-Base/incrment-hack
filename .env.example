# ============================================================================
#  CRM «ИТ Школа РТК» — пример конфигурации
#  Скопируйте в .env и подставьте значения. Все переменные валидируются
#  zod-схемой при старте: неверная конфигурация роняет процесс сразу,
#  а не через час работы (fail fast).
# ============================================================================

# --- Приложение -------------------------------------------------------------
NODE_ENV=development
# Роль процесса: api (HTTP+WS) или worker (фоновые задачи). Образ один, роли разные.
APP_ROLE=api
PORT=3000
API_PREFIX=api
# Домены фронтенда через запятую. В production '*' запрещён валидацией.
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
LOG_LEVEL=debug

# --- PostgreSQL -------------------------------------------------------------
DATABASE_URL=postgresql://crm:crm_dev_password@localhost:5432/crm?schema=public
# Размер пула на один процесс. Суммарно по всем репликам не должен превышать
# max_connections Postgres (по умолчанию 100).
DB_POOL_MAX=20

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Keycloak (OIDC) --------------------------------------------------------
# Внутренний адрес: по нему бэкенд забирает ключи проверки подписи (JWKS).
KEYCLOAK_BASE_URL=http://localhost:8080
# Публичный адрес, который видит браузер, — он попадает в claim `iss` токена.
# В docker compose бэкенд ходит на http://keycloak:8080, а токен выпускается
# с issuer http://localhost:8080. Без этой переменной проверка issuer
# отвергала бы корректные токены. Пусто — совпадает с KEYCLOAK_BASE_URL.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=rtk-crm
KEYCLOAK_CLIENT_ID=crm-backend
# Ожидаемый audience в JWT. Пусто — проверка audience пропускается.
KEYCLOAK_AUDIENCE=crm-backend
# ВНИМАНИЕ: обход аутентификации для локальной разработки без Keycloak.
# Валидация запрещает включать это при NODE_ENV=production.
AUTH_DEV_BYPASS=false
# Роль, выдаваемая фиктивному пользователю при AUTH_DEV_BYPASS=true
AUTH_DEV_BYPASS_ROLE=ADMIN

# --- Объектное хранилище (MinIO / S3) ---------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_ATTACHMENTS=crm-attachments
S3_BUCKET_REPORTS=crm-reports
# Для MinIO обязательно true (S3-совместимость по пути, а не по поддомену).
S3_FORCE_PATH_STYLE=true
# Шифрование объектов на стороне хранилища: none либо AES256.
# AES256 требует настроенного KMS в MinIO; при его отсутствии оставьте none
# и обеспечьте шифрование средствами файловой системы узла.
S3_SERVER_SIDE_ENCRYPTION=none

# --- Отчёты -----------------------------------------------------------------
# Порог синхронной генерации: меньше строк — рендерим в запросе,
# больше — уходим в очередь с ответом 202. См. §3.1 архитектуры.
REPORT_SYNC_ROW_THRESHOLD=2000
# Жёсткий предел строк в одном отчёте — защита от выгрузки всей БД.
REPORT_MAX_ROWS=500000
# Сколько держать готовый файл отчёта в кэше (секунды).
REPORT_CACHE_TTL_SEC=3600
# Параллельных задач на один worker-процесс. Суммарно по репликам
# должно быть >= 10 (НФТ 7).
WORKER_CONCURRENCY=4

# --- Загрузка файлов --------------------------------------------------------
UPLOAD_MAX_FILE_SIZE_MB=50
# Предел для импортируемых таблиц. Ниже общего: файл разбирается в памяти
# целиком, поэтому его размер прямо определяет расход памяти воркера.
IMPORT_MAX_FILE_SIZE_MB=25
# Антивирусная проверка загрузок (мера АВЗ по требованиям ФСТЭК).
# ВНИМАНИЕ: CLAMAV_ENABLED=false запрещён при NODE_ENV=production —
# иначе система принимала бы и раздавала непроверенные файлы.
# Значение по умолчанию рассчитано на запуск в Docker: docker-compose.yml
# задаёт процессам NODE_ENV=production, и с false они не стартуют.
# При запуске приложения локально (вариант 2 в README) либо поднимите
# контейнер: docker compose --profile security up -d clamav
# либо поставьте здесь false — локально NODE_ENV=development это разрешает.
CLAMAV_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Выдавать ли файлы, загруженные без успешной антивирусной проверки
# (вердикты SKIPPED и ERROR). В production запрещено; администратор
# получает такие файлы всегда — без этого нельзя разобрать инцидент.
ALLOW_UNSCANNED_DOWNLOAD=false

# --- Ограничение интенсивности обращений ------------------------------------
# Защита от перебора идентификаторов и от массовой выгрузки персональных
# данных штатными методами API. Счётчики общие для всех реплик (Redis).
THROTTLE_TTL_SEC=60
# Общий лимит обращений на пользователя за окно.
THROTTLE_LIMIT=300
# Строгий лимит для выгрузок: отчёты, импорт, вложения, реестр субъектов ПДн.
THROTTLE_EXPORT_LIMIT=30

# --- Сроки хранения данных (152-ФЗ, ч. 7 ст. 5) -----------------------------
# Регламентная очистка выполняется процессом worker, одной репликой.
RETENTION_CRON=0 30 3 * * *
# Журнал аудита: три года — типовой срок хранения журналов ИБ.
AUDIT_RETENTION_DAYS=1095
# Срок хранения ПДн по умолчанию (если не задан для конкретной записи).
PERSONAL_DATA_RETENTION_DAYS=1095
# Отсрочка физического удаления вложений после пометки удалёнными:
# позволяет отменить ошибочное удаление.
ATTACHMENT_PURGE_GRACE_DAYS=30
# Черновики, рабочие контексты и списки недавнего.
WORKSPACE_RETENTION_DAYS=90

# --- Документация API -------------------------------------------------------
# Swagger UI раскрывает полную карту API и структуру данных. В production
# либо задайте пароль, либо отключите публикацию — иначе процесс не стартует.
SWAGGER_ENABLED=true
SWAGGER_USER=docs
# Пустое значение при NODE_ENV=production роняет процесс на старте, а в Docker
# режим именно production. Для локального стенда достаточно любого пароля.
SWAGGER_PASSWORD=docs

# --- Кэш действий пользователя ----------------------------------------------
# TTL рабочего контекста (фильтры, колонки, открытые вкладки) в Redis.
ACTIVITY_STATE_TTL_SEC=604800
# TTL ключей идемпотентности (защита от дублей при повторной отправке).
IDEMPOTENCY_TTL_SEC=86400

# --- Уведомления ------------------------------------------------------------
# Расписание рассылки напоминаний о зависших заявках. Порог простоя задаётся
# не здесь, а в интерфейсе администратором: заказчик просил сделать срок
# настраиваемым, а не зашитым в развёртывание.
ESCALATION_CRON=0 0 9 * * *

# --- Календарь задач --------------------------------------------------------
# Часовой пояс организации (имя IANA). В нём считаются календарные дни задач:
# «задача на 30 сентября», задача на время и признак просрочки. Время в базе
# хранится в UTC, а день — понятие местное.
APP_TIMEZONE=Europe/Moscow
# Как часто проверять наступившие напоминания о задачах. Раз в минуту:
# напоминание «в 9:00» не должно приходить в 9:15.
TASK_REMINDER_CRON=0 * * * * *

# --- Интеграции с LMS и сайтом ----------------------------------------------
# Режим обмена. stub — двусторонний обмен на встроенных примерах данных,
# без обращения в сеть; live — обращение к реальным адресам систем заказчика.
# Контракт внешних систем на момент разработки не передан, поэтому stub.
# stub — обмен на встроенных примерах без сети; live — обращение по адресам
# ниже. В поставке рядом поднимается имитатор внешних систем (mock-external),
# поэтому режим live работает сразу, без доступа к системам заказчика.
INTEGRATION_MODE=stub
LMS_BASE_URL=http://mock-external:4010
LMS_TOKEN=
CMS_BASE_URL=http://mock-external:4011
CMS_TOKEN=
# Общий секрет для проверки подписи входящих вызовов (заголовок x-signature,
# HMAC-SHA256 тела запроса в hex). Им же подписывает вызовы имитатор внешних
# систем. При NODE_ENV=production пустое значение закрывает приём событий
# (ответ 503), а при INTEGRATION_MODE=live роняет процесс на старте:
# неподписанные вызовы принимать нельзя. Значение ниже годится только для
# локальной разработки.
INTEGRATION_WEBHOOK_SECRET=local-dev-webhook-secret
# Кому доверять заголовок X-Forwarded-For: по умолчанию частным сетям
# и локальному узлу. Иначе — список адресов и подсетей прокси через
# запятую. true доверяет любому клиенту — адрес в журнале аудита и
# ограничение частоты тогда подделываются заголовком.
# TRUST_PROXY=loopback,linklocal,uniquelocal
# Адреса ботов мессенджеров (в интерфейсе они не меняются).
# NOTIFY_TELEGRAM_API_URL=https://api.telegram.org
# NOTIFY_MAX_API_URL=https://botapi.max.ru
# Ключ маскирования персональных данных в журнале аудита (HMAC). Без ключа
# отпечаток ФИО подбирается перебором словаря имён. Локальный Docker-стек
# работает с NODE_ENV=production и без ключа длиной от 32 символов не стартует.
# Значение ниже — только для разработки.
AUDIT_MASK_KEY=local-dev-audit-mask-key-0123456789abcdef
INTEGRATION_HTTP_TIMEOUT_MS=15000
# Опрос внешних систем и отправка накопленных исходящих событий.
INTEGRATION_SYNC_CRON=0 */15 * * * *
INTEGRATION_OUTBOX_CRON=*/30 * * * * *

# --- ИИ (внешние LLM) -------------------------------------------------------
# Система полностью работоспособна при LLM_ENABLED=false — ИИ только подсказывает.
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000
# Деперсонализация ПДн перед отправкой во внешний сервис.
# Отключение запрещено валидацией при NODE_ENV=production (требование 152-ФЗ).
LLM_DEPERSONALIZE=true
