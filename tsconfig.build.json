{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // TypeScript 6 требует явного rootDir. Ограничиваем сборку каталогом src,
    // чтобы на выходе получилось dist/main.js, а не dist/src/main.js.
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts", "**/*.e2e-spec.ts"]
}
