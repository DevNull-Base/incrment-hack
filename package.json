{
  "name": "rtk-university-crm",
  "version": "0.1.0",
  "description": "CRM для контроля взаимодействия с вузами по ИТ-направлениям (ИТ Школа РТК)",
  "license": "MIT",
  "private": true,
  "//": "ESM обязателен: NestJS 12, Kysely и Zod публикуются только как ES-модули и недоступны через require().",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "worker": "node dist/worker.js",
    "worker:dev": "nest start --watch --entryFile worker",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:ci": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "openapi:export": "npm run build && node dist/bootstrap/export-openapi.js",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm --omit dev --output-file docs/sbom.json",
    "check:catalog": "node test/manual/catalog-check.mjs",
    "check:workflow": "node test/manual/workflow-check.mjs",
    "check:files": "node test/manual/files-check.mjs",
    "check:realtime": "node test/manual/realtime-check.mjs",
    "check:antivirus": "node test/manual/antivirus-check.mjs",
    "check:all": "npm run check:catalog && npm run check:workflow && npm run check:files && npm run check:realtime && npm run check:import && npm run check:reports && npm run check:activity && npm run check:notes-calendar && npm run check:payments && npm run check:vendors && npm run check:security && npm run check:access && npm run check:university",
    "check:import": "node test/manual/import-check.mjs",
    "check:reports": "node test/manual/reports-check.mjs",
    "check:activity": "node test/manual/activity-check.mjs",
    "check:notes-calendar": "node test/manual/notes-calendar-check.mjs",
    "check:payments": "node test/manual/payments-lms-check.mjs",
    "check:vendors": "node test/manual/vendor-import-check.mjs",
    "check:security": "node test/manual/security-check.mjs",
    "check:access": "node test/manual/access-check.mjs",
    "check:university": "node test/manual/archive-university-check.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "lodash": "^4.18.1",
    "mysql2": "^3.24.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/lib-storage": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@casl/ability": "^7.0.1",
    "@fastify/compress": "^9.2.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.3",
    "@nestjs/platform-socket.io": "^12.0.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/websockets": "^12.0.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prometheus-io/client": "^0.16.1",
    "@resvg/resvg-js": "^2.6.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cockatiel": "^4.0.0",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "fast-csv": "^5.0.7",
    "file-type": "^22.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.5",
    "nestjs-pino": "^5.2.0",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.0",
    "pg-query-stream": "^4.17.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "piscina": "^5.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xstate": "^5.33.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.1",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.3",
    "@types/node": "^26.5.1",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
