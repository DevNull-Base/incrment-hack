{
  "compilerOptions": {
    // node16 — актуальный режим для CommonJS-проекта на Node.js:
    // разрешение модулей учитывает "type" в package.json и exports-карты.
    // Прежние "commonjs"/"node" объявлены устаревшими в TypeScript 6.
    "module": "node16",
    "target": "ES2023",
    "lib": ["ES2023"],
    "moduleResolution": "node16",
    "declaration": false,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    // Без baseUrl пути разрешаются относительно самого tsconfig.json.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "prisma/**/*", "scripts/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
