# ============================================================================
#  Настройки стенда. Файл лежит на сервере в C:\www\incrment/.env и НЕ попадает
#  в репозиторий и в CI: пароли не должны проходить через сборочный конвейер.
#
#  Создаётся один раз руками:
#    Copy-Item deploy\env.prod.example C:\www\incrment\.env
#  и дальше правится на месте.
# ============================================================================

# --- Адреса стенда ----------------------------------------------------------
# Домен, который отдаёт Caddy. Схема обязательна: значение уходит в CORS,
# в claim `iss` и в адреса возврата Keycloak.
PUBLIC_APP_URL=https://incrment.ru
PUBLIC_AUTH_URL=https://auth.incrment.ru

# --- Порты на петлевом интерфейсе -------------------------------------------
# Единственное, что контейнеры публикуют наружу процесса Docker. Оба адреса
# слушаются на 127.0.0.1, поэтому снаружи сервера недоступны — только Caddy.
# Значения выбраны заведомо свободными; проверить занятость:
#   Get-NetTCPConnection -State Listen -LocalPort 18080, 18081 -ErrorAction SilentlyContinue
API_BIND_PORT=18080
KEYCLOAK_BIND_PORT=18081

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=crm
POSTGRES_PASSWORD=ЗАМЕНИТЬ_НА_ДЛИННЫЙ_ПАРОЛЬ
POSTGRES_DB=crm

# База Keycloak в том же экземпляре Postgres. Создаётся при первом старте.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=ЗАМЕНИТЬ_НА_ДЛИННЫЙ_ПАРОЛЬ

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ЗАМЕНИТЬ_НА_ДЛИННЫЙ_ПАРОЛЬ
KEYCLOAK_REALM=rtk-crm
KEYCLOAK_CLIENT_ID=crm-backend
KEYCLOAK_AUDIENCE=crm-backend

# --- Объектное хранилище ----------------------------------------------------
S3_ACCESS_KEY=crm-stand
S3_SECRET_KEY=ЗАМЕНИТЬ_НА_ДЛИННЫЙ_ПАРОЛЬ
S3_BUCKET_ATTACHMENTS=crm-attachments
S3_BUCKET_REPORTS=crm-reports
# Шифрование на стороне хранилища: none либо SSE-S3.
S3_SERVER_SIDE_ENCRYPTION=none

# --- Документация API -------------------------------------------------------
# Swagger доступен по https://incrment.ru/api/docs и закрыт этим паролем.
# Пустое значение при NODE_ENV=production роняет процесс на старте.
SWAGGER_ENABLED=true
SWAGGER_USER=docs
SWAGGER_PASSWORD=ЗАМЕНИТЬ_НА_ДЛИННЫЙ_ПАРОЛЬ

# --- Прочее -----------------------------------------------------------------
LOG_LEVEL=info
WORKER_CONCURRENCY=4

# Ограничение интенсивности обращений: разграничение доступа отвечает,
# кому что видно, но не ограничивает объём выгрузки.
THROTTLE_TTL_SEC=60
THROTTLE_LIMIT=300
THROTTLE_EXPORT_LIMIT=30

# Сроки хранения (152-ФЗ). Регламентную очистку выполняет worker.
RETENTION_CRON=0 30 3 * * *
AUDIT_RETENTION_DAYS=1095
PERSONAL_DATA_RETENTION_DAYS=1095
ATTACHMENT_PURGE_GRACE_DAYS=30
WORKSPACE_RETENTION_DAYS=90

# --- Демонстрационное наполнение --------------------------------------------
# Реальных данных заказчик не предоставляет, поэтому стенд наполняется
# подготовленным набором: каталоги вузов, продуктов и направлений,
# взаимодействия с историей переходов, тестовые пользователи.
#
# Шаг выполняется при каждой выкладке и идемпотентен: существующие записи
# не трогаются, настроенный администратором процесс не подменяется.
# На стенде с боевыми данными значение обязательно false.
SEED_DEMO_DATA=true

# --- Уведомления ------------------------------------------------------------
# Рассылка напоминаний о зависших заявках: ежедневно к началу рабочего дня.
# Порог простоя в днях настраивается администратором в интерфейсе.
ESCALATION_CRON=0 0 9 * * *

# --- Календарь задач --------------------------------------------------------
# Дни задач считаются в часовом поясе организации; напоминания проверяются
# раз в минуту.
APP_TIMEZONE=Europe/Moscow
TASK_REMINDER_CRON=0 * * * * *

# --- Обмен с LMS и сайтом ---------------------------------------------------
# Настоящих систем у стенда нет: рядом поднимается имитатор (служба
# mock-external), и обмен идёт с ним по сети — так двусторонность видно
# по-настоящему, а не на встроенных заглушках.
#
# Когда заказчик передаст контракт: выключите имитатор, пропишите его адреса
# на настоящие и оставьте режим live.
INTEGRATION_MODE=live
LMS_BASE_URL=http://mock-external:4010
CMS_BASE_URL=http://mock-external:4011
LMS_TOKEN=
CMS_TOKEN=
# Обязателен при INTEGRATION_MODE=live: им подписываются входящие вызовы
# внешних систем. С пустым значением процесс не стартует.
INTEGRATION_WEBHOOK_SECRET=ЗАМЕНИТЬ_НА_ДЛИННЫЙ_ПАРОЛЬ
# Ключ маскирования персональных данных в журнале аудита. Менять не нужно
# без причины: отпечатки до и после смены ключа несравнимы. deploy.ps1
# создаёт его сам, если значение пустое или осталось меткой из образца.
AUDIT_MASK_KEY=ЗАМЕНИТЬ_НА_ДЛИННЫЙ_ПАРОЛЬ
