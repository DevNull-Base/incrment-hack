# Локальная разработка с бэкендом: cp .env.example .env
# Без файла .env фронтенд работает автономно: демо-вход и данные из моков.

# Адрес бэкенда для прокси дев-сервера (/api и /socket.io).
# Только для npm run dev / preview; в сборку не попадает.
VITE_API_TARGET=http://localhost:3000

# Keycloak: значения совпадают с keycloak/realm-export.json.
# Заданный адрес включает вход через Keycloak вместо демо-входа.
# На стенде значения подставляет CI (переменные PUBLIC_AUTH_URL и др.).
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=rtk-crm
VITE_KEYCLOAK_CLIENT_ID=crm-frontend

# Источник данных стора: api — всё с бэкенда; mock — демо на моках
# (значение по умолчанию, если переменная не задана).
VITE_DATA_SOURCE=api
